<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>
    <entry key='config.default'>./conf/default.xml</entry>
    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>
    <!-- 位置转发：电量、心率、坐标 → 安心照顾自己判断安全范围、低电量、心跳 -->
    <entry key='forward.enable'>true</entry>
    <entry key='forward.type'>json</entry>
    <entry key='forward.url'>http://anxin:8787/api/integrations/traccar/position?key=TRACCAR_KEY_请与.env一致</entry>
    <entry key='forward.retry.enable'>true</entry>
    <!-- 事件转发：SOS、跌倒、摘下、离线 -->
    <entry key='event.forward.enable'>true</entry>
    <entry key='event.forward.type'>json</entry>
    <entry key='event.forward.url'>http://anxin:8787/api/integrations/traccar?key=TRACCAR_KEY_请与.env一致</entry>
    <!-- 多久没信号算离线（秒） -->
    <entry key='status.timeout'>900</entry>
</properties>
