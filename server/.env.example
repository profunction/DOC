# 生产环境请全部设置
PORT=8787
JWT_SECRET=请换成一串长随机字符
DATA_KEY=64位十六进制（openssl rand -hex 32），用于加密健康资料
HOTLINE_PHONE=60123456789
SEED_DEMO=0
# 第一个协调员账号（登录后再在 App 里建其他账号）
ADMIN_PHONE=0123456789
ADMIN_PASSWORD=请换成强密码
ADMIN_NAME=总协调员
# DATA_DIR=/var/lib/anxin
# WEB_DIR=/srv/anxin/web

# 开源推送 ntfy（可选）：协调员手机装 ntfy App 订阅同一个 topic
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=anxin-alerts-请换成一串随机字符
# NTFY_TOKEN=

# 开源 GPS 服务器 Traccar（可选）：在 Traccar 的 traccar.xml 里设置
#   <entry key='event.forward.enable'>true</entry>
#   <entry key='event.forward.url'>https://你的域名/api/integrations/traccar?key=TRACCAR_KEY</entry>
# 客人档案的"智能手表"栏填手表在 Traccar 里的 uniqueId（通常是 IMEI）
# TRACCAR_KEY=请换成一串随机字符

# 地图（可选）：Google Maps 浏览器钥匙 + 开通 Maps JavaScript API 与 Geocoding API。没填用 OpenStreetMap。
# GOOGLE_MAPS_KEY=
# 子女 App 推送（可选）：Firebase 服务账号 JSON 整段
# FCM_SERVICE_ACCOUNT=
